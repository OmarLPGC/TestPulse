APP_ENV=development
POSTGRES_DB=testpulse
POSTGRES_USER=testpulse
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
API_PORT=8000
MAX_JUNIT_REPORT_BYTES=10485760
MAX_JUNIT_TEST_CASES=100000
SESSION_TTL_SECONDS=1209600

# Configure all five GitHub App values together to enable login and repository discovery.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_CALLBACK_URL=
PUBLIC_BASE_URL=
GITHUB_TOKEN_ENCRYPTION_KEY=

# Required only to let the matching GitHub account claim projects from the legacy workspace.
TESTPULSE_BOOTSTRAP_GITHUB_USER_ID=

# For local development, you can generate a personal access token and use it to authenticate with the TestPulse API.
TESTPULSE_API_TOKEN=
